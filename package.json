{
  "name": "dryland-ade",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm --filter @dryland/cli build",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,html,mjs,json}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,html,mjs,json}\" \"*.{js,ts,json}\"",
    "package": "pnpm --filter @dryland/desktop package",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "test:linux": "node scripts/test-linux.mjs",
    "test:e2e:linux": "node scripts/test-e2e-linux.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
